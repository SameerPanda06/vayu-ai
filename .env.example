# Vayu AI - Environment Configuration Template

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Settings (PostgreSQL via psycopg v3)
# Note: Never commit secrets or hardcoded passwords to version control.
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vayu_ai

# Air Quality Ingestion Source Mode
# Options:
#   - 'cpcb'       : Ingest official CPCB ground monitoring station data only
#   - 'open_meteo'  : Ingest Open-Meteo numerical atmospheric estimates only (development fallback)
#   - 'auto'       : Primary CPCB source with automatic Open-Meteo fallback on network/upstream failures
AQI_INGESTION_SOURCE=auto

# Primary Data Source: Official Data.gov.in CPCB Real-time Air Quality API
# Register at https://data.gov.in to obtain a free API key
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_IN_TIMEOUT_SECONDS=15.0

# Development Fallback: Open-Meteo Air Quality API
# Free for non-commercial open-source development (no API key required)
# Attribution: Open-Meteo (https://open-meteo.com/) / Copernicus Atmosphere Monitoring Service (CAMS)
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_TIMEOUT_SECONDS=15.0
OPEN_METEO_PAST_HOURS=6
OPEN_METEO_FORECAST_HOURS=1

# Frontend Settings (consumed during build / dev by Vite)
VITE_API_BASE_URL=http://localhost:8000/api
